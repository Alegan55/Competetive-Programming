#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<int> dijkstra(int V, vector<vector<pair<int, int>>>& adj, int S) {
        
        // Set stores {distance, node}
        // It keeps elements sorted by distance automatically
        set<pair<int, int>> st;

        vector<int> dist(V, 1e9); 

        dist[S] = 0;
        st.insert({0, S});

        while (!st.empty()) {
            // Get the node with the smallest distance (Top of the "heap")
            auto it = *(st.begin());
            int d = it.first;
            int u = it.second;
            st.erase(it);

            for (auto& edge : adj[u]) {
                int v = edge.first;
                int weight = edge.second;

                // RELAXATION
                if (d + weight < dist[v]) {
                    
                    // If the node was already in the set with a larger distance,
                    // erase it to "update" it.
                    if (dist[v] != 1e9) {
                        st.erase({dist[v], v});
                    }

                    dist[v] = d + weight;
                    st.insert({dist[v], v});
                }
            }
        }
        return dist;
    }
};
