#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

class Solution {
public:
    long long maximumProfit(vector<int>& prices, int k) {
        // 'l' and 'r' represent the range of our "Transaction Tax" (lambda)
        long long l = 0, r = 1e9 + 7, ans = 0;
        int n = prices.size();

        if (n == 0) return 0;

        while (l <= r) {
            long long mid = l + (r - l) / 2; // This is our current penalty (tax) per trade
            
            /* DP State: pair<Profit, -TradeCount>
               We use negative trade count because std::max() will naturally pick 
               the option with the HIGHER second value (which means fewer trades) 
               if the profits are tied.
            */
            pair<long long, int> neutral = {0, 0};
            pair<long long, int> held = {-(long long)prices[0], 0};
            pair<long long, int> shorted = {(long long)prices[0], 0};

            for (int i = 1; i < n; ++i) {
                // 1. Can we become Neutral? 
                // Either stay neutral, sell a Long (+price - tax), or buy back a Short (-price - tax)
                pair<long long, int> next_neutral = max({
                    neutral,
                    {held.first + prices[i] - mid, held.second - 1},
                    {shorted.first - prices[i] - mid, shorted.second - 1}
                });

                // 2. Can we become 'Held' (Long)?
                // Either stay holding, or open a new Long from Neutral
                pair<long long, int> next_held = max(held, {neutral.first - prices[i], neutral.second});

                // 3. Can we become 'Shorted'?
                // Either stay shorted, or open a new Short from Neutral
                pair<long long, int> next_shorted = max(shorted, {neutral.first + prices[i], neutral.second});

                neutral = next_neutral;
                held = next_held;
                shorted = next_shorted;
            }

            // The actual number of trades we made is -neutral.second
            int actual_trades = -neutral.second;

            if (actual_trades <= k) {
                // If we used k or fewer trades, this tax is high enough.
                // Calculate real profit by adding the tax back for k trades.
                ans = neutral.first + mid * k;
                r = mid - 1; // Try lowering the tax to see if we can get more profit
            } else {
                // Too many trades! We need to increase the tax.
                l = mid + 1;
            }
        }
        return ans;
    }
};
