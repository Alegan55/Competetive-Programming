class FloydWarshall {
public:
    void shortest_distance(vector<vector<int>>& matrix) {
        int n = matrix.size();

        // Step 1: Pre-process the matrix
        // Replace -1 with a large value (infinity)
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (matrix[i][j] == -1) matrix[i][j] = 1e9;
                if (i == j) matrix[i][j] = 0;
            }
        }

        // Step 2: The Core Algorithm (Middleman K)
        for (int k = 0; k < n; k++) {
            for (int i = 0; i < n; i++) {
                for (int j = 0; j < n; j++) {
                    // Only update if path through K is shorter
                    if (matrix[i][k] != 1e9 && matrix[k][j] != 1e9) {
                        matrix[i][j] = min(matrix[i][j], matrix[i][k] + matrix[k][j]);
                    }
                }
            }
        }

        // Step 3: Post-process (Optional)
        // Convert large values back to -1 for LeetCode format
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (matrix[i][j] == 1e9) matrix[i][j] = -1;
            }
        }
    }
    
    // Check for Negative Cycle
    bool hasNegativeCycle(vector<vector<int>>& matrix) {
        int n = matrix.size();
        for (int i = 0; i < n; i++) {
            if (matrix[i][i] < 0) return true;
        }
        return false;
    }
};
